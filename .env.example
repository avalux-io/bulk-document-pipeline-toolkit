# AWS credentials used by src/extract_documents.py (AWS Textract)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Minimum confidence (0-100) below which extracted fields are flagged for manual review
EXTRACTION_CONFIDENCE_THRESHOLD=85

# Optional: S3 bucket for storing generated/incoming documents in production use
DOCUMENT_BUCKET=

# Optional: override the default invoice template path
INVOICE_TEMPLATE_PATH=templates/invoice_template.html
